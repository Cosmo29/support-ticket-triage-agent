# Server Configuration
PORT=8000
HOST=0.0.0.0
STREAMLIT_PORT=8501
LOG_LEVEL=INFO
ENVIRONMENT=development

# LLM Providers (Optional: system provides rich zero-shot simulated fallback if unconfigured)
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# Triage & Escalation Thresholds
CONFIDENCE_THRESHOLD=0.75
ENABLE_PROMPT_INJECTION_SHIELD=true
AUTO_ESCALATE_P0=true

# Connectors Configuration
ZENDESK_SUBDOMAIN=sandbox-company
ZENDESK_EMAIL=agent@example.com
ZENDESK_API_TOKEN=your_zendesk_token_here
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/MOCK/TOKEN/WEBHOOK
SLACK_ESCALATION_CHANNEL=#support-escalations

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/tickets.db
